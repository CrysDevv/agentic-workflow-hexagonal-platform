---
 deploy/k8s/config.yaml | 50 ++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 50 insertions(+)
 create mode 100644 deploy/k8s/config.yaml

diff --git a/deploy/k8s/config.yaml b/deploy/k8s/config.yaml
new file mode 100644
index 0000000..750794f
--- /dev/null
+++ b/deploy/k8s/config.yaml
@@ -0,0 +1,50 @@
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: agentic-config
+  labels:
+    app.kubernetes.io/part-of: agentic-workflow-hexagonal-platform
+data:
+  NODE_ENV: "production"
+  LOG_LEVEL: "info"
+  AWS_REGION: "us-east-2"
+  # Vacío para usar AWS real (S3/SQS us-east-2); con LocalStack apunta al Service interno.
+  AWS_ENDPOINT_URL: "http://localstack:4566"
+  S3_BUCKET: "agentic-artifacts"
+  SQS_QUEUE_NAME: "agentic-tasks"
+  SQS_DLQ_NAME: "agentic-tasks-dlq"
+  SQS_QUEUE_URL: "http://localstack:4566/000000000000/agentic-tasks"
+  QUEUE_DRIVER: "redis"
+  JWT_EXPIRES_IN: "15m"
+  # Para pruebas de carga desde una sola IP eleve RATE_LIMIT_MAX (p. ej. "100000").
+  RATE_LIMIT_MAX: "60"
+  RATE_LIMIT_WINDOW_SECONDS: "60"
+  LLM_PROVIDER: "local-deterministic"
+  ANTHROPIC_MODEL: "claude-sonnet-4-5"
+  CORS_ORIGINS: "http://localhost:5173,http://127.0.0.1:5173"
+  OTEL_EXPORTER_OTLP_ENDPOINT: "http://otel-collector.monitoring.svc.cluster.local:4318"
+  OTEL_SERVICE_NAME: "core-nestjs"
+  VITE_API_BASE_URL: "http://localhost:3000"
+---
+# Valores de DESARROLLO (prefijo CAMBIAR-). En producción reemplace este objeto con
+# Sealed Secrets / External Secrets / OCI Vault y no versione credenciales reales.
+apiVersion: v1
+kind: Secret
+metadata:
+  name: agentic-secrets
+  labels:
+    app.kubernetes.io/part-of: agentic-workflow-hexagonal-platform
+type: Opaque
+stringData:
+  POSTGRES_DB: "agentic_platform"
+  POSTGRES_USER: "agentic_app"
+  POSTGRES_PASSWORD: "CAMBIAR-password-postgres-0123456789"
+  REDIS_PASSWORD: "CAMBIAR-password-redis-0123456789"
+  DATABASE_URL: "postgresql://agentic_app:CAMBIAR-password-postgres-0123456789@postgres:5432/agentic_platform"
+  REDIS_URL: "redis://:CAMBIAR-password-redis-0123456789@redis:6379"
+  AWS_ACCESS_KEY_ID: "test"
+  AWS_SECRET_ACCESS_KEY: "test"
+  JWT_SECRET: "CAMBIAR-jwt-secret-minimo-64-caracteres-aleatorios-0123456789abcdef"
+  WEBHOOK_HMAC_SECRET: "CAMBIAR-webhook-hmac-secret-minimo-32-caracteres"
+  API_KEYS: "admin:ADMIN:CAMBIAR-api-key-admin-0123456789abcdef,aprobador:APROBADOR:CAMBIAR-api-key-aprobador-0123456789abcdef"
+  ANTHROPIC_API_KEY: ""
