From e6b1d74c8f498fe76b43aafdc18513ea1fd55a46 Mon Sep 17 00:00:00 2001
From: CrysDevv <cryssdev@gmail.com>
Date: Fri, 20 Nov 2026 01:09:03 -0300
Subject: [PATCH 6/7] =?UTF-8?q?build:=20a=C3=B1adir=20servicio=20Ollama=20?=
 =?UTF-8?q?opcional=20con=20perfil=20de=20Compose=20y=20variables=20OLLAMA?=
 =?UTF-8?q?=5F*?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

---
 .env.example       |  8 +++++++-
 docker-compose.yml | 31 ++++++++++++++++++++++++++++++-
 2 files changed, 37 insertions(+), 2 deletions(-)

diff --git a/.env.example b/.env.example
index fe622d6..d851e4c 100644
--- a/.env.example
+++ b/.env.example
@@ -31,7 +31,7 @@ RATE_LIMIT_MAX=60
 RATE_LIMIT_WINDOW_SECONDS=60
 
 # ===== Adaptador LLM =====
-# local-deterministic (costo $0) | anthropic
+# local-deterministic (costo $0, sin API Key) | ollama (modelos locales) | anthropic (requiere API Key)
 LLM_PROVIDER=local-deterministic
 ANTHROPIC_API_KEY=
 ANTHROPIC_MODEL=claude-sonnet-4-5
@@ -45,3 +45,9 @@ VITE_API_BASE_URL=http://localhost:3000
 
 # ===== Autenticación por API Key (formato nombre:ROL:clave separados por coma; ROL = ADMIN | APROBADOR) =====
 API_KEYS=admin:ADMIN:cambiar_api_key_admin_minimo_32_caracteres,aprobador:APROBADOR:cambiar_api_key_aprobador_minimo_32_caracteres
+
+# ===== Ollama (opcional: modelos locales sin API Key) =====
+# docker compose --profile ollama up -d   y   docker compose exec ollama ollama pull llama3.2:3b
+# El proveedor activo también se elige desde la consola (pestaña "Modelo de IA"); esa selección tiene prioridad.
+OLLAMA_BASE_URL=http://ollama:11434
+OLLAMA_MODEL=llama3.2:3b
diff --git a/docker-compose.yml b/docker-compose.yml
index 60e7b56..2d4ef10 100644
--- a/docker-compose.yml
+++ b/docker-compose.yml
@@ -123,6 +123,8 @@ services:
       LLM_PROVIDER: ${LLM_PROVIDER:-local-deterministic}
       ANTHROPIC_API_KEY: ${ANTHROPIC_API_KEY:-}
       ANTHROPIC_MODEL: ${ANTHROPIC_MODEL:-claude-sonnet-4-5}
+      OLLAMA_BASE_URL: ${OLLAMA_BASE_URL:-http://ollama:11434}
+      OLLAMA_MODEL: ${OLLAMA_MODEL:-llama3.2:3b}
       OTEL_EXPORTER_OTLP_ENDPOINT: ${OTEL_EXPORTER_OTLP_ENDPOINT:-http://otel-collector:4318}
       OTEL_SERVICE_NAME: ${OTEL_SERVICE_NAME:-core-nestjs}
     ports:
@@ -148,7 +150,7 @@ services:
   frontend-react:
     build:
       context: ./frontend-react
-      dockerfile: ../docker/Dockerfile.node20
+      dockerfile: ../docker/Dockerfile.frontend-node20
     image: agentic/frontend-react:local
     container_name: agentic-frontend-react
     restart: unless-stopped
@@ -165,6 +167,32 @@ services:
     networks:
       - frontend
 
+  # Opcional (perfil "ollama"): modelos locales sin API Key. Activar con: docker compose --profile ollama up -d
+  # Ollama necesita root para escribir su caché de modelos; se compensa con cap_drop, no-new-privileges y read_only.
+  ollama:
+    image: ollama/ollama:latest
+    container_name: agentic-ollama
+    profiles: ["ollama"]
+    restart: unless-stopped
+    volumes:
+      - ollama_data:/root/.ollama
+    ports:
+      - "127.0.0.1:11434:11434"
+    read_only: true
+    tmpfs:
+      - /tmp
+    cap_drop:
+      - ALL
+    security_opt:
+      - no-new-privileges:true
+    healthcheck:
+      test: ["CMD", "ollama", "list"]
+      interval: 10s
+      timeout: 5s
+      retries: 10
+    networks:
+      - backend
+
 networks:
   backend:
     driver: bridge
@@ -175,3 +203,4 @@ volumes:
   postgres_data:
   redis_data:
   localstack_data:
+  ollama_data:
-- 
