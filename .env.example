# ===== General =====
NODE_ENV=production
CORE_PORT=3000
FRONTEND_PORT=5173
LOG_LEVEL=info

# ===== PostgreSQL 16 =====
POSTGRES_DB=agentic_platform
POSTGRES_USER=agentic_app
POSTGRES_PASSWORD=cambiar_password_postgres_32chars
POSTGRES_PORT=5432

# ===== Redis 7 =====
REDIS_PASSWORD=cambiar_password_redis_32chars
REDIS_PORT=6379

# ===== LocalStack (AWS local, costo $0) =====
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566
S3_BUCKET=agentic-artifacts
SQS_QUEUE_NAME=agentic-tasks
SQS_DLQ_NAME=agentic-tasks-dlq

# ===== Seguridad =====
JWT_SECRET=cambiar_jwt_secret_minimo_64_caracteres_aleatorios_0123456789abcdef
JWT_EXPIRES_IN=15m
WEBHOOK_HMAC_SECRET=cambiar_webhook_hmac_secret_minimo_32_caracteres
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SECONDS=60

# ===== Adaptador LLM =====
# local-deterministic (costo $0) | anthropic
LLM_PROVIDER=local-deterministic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ===== Observabilidad =====
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=core-nestjs

# ===== Frontend =====
VITE_API_BASE_URL=http://localhost:3000

# ===== Autenticación por API Key (formato nombre:ROL:clave separados por coma; ROL = ADMIN | APROBADOR) =====
API_KEYS=admin:ADMIN:cambiar_api_key_admin_minimo_32_caracteres,aprobador:APROBADOR:cambiar_api_key_aprobador_minimo_32_caracteres
